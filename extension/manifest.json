{
  "manifest_version": 3,
  "name": "L.A.M.F.I.",
  "version": "1.0.0",
  "description": "LinkedIn outreach: auto-connect, AI-personalised messages, and a local CRM.",
  "permissions": ["storage", "unlimitedStorage", "contextMenus"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "L.A.M.F.I. — open dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": [
        "content/dom.js",
        "content/connect.js",
        "content/profile.js",
        "content/hud.js",
        "content/main.js"
      ],
      "css": ["content/hud.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png"],
      "matches": ["https://www.linkedin.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
